<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:macros="sap.fe.macros" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="demo.com.demofpm.ext.main.Main" xmlns:f="sap.f" xmlns:v="sap.ui.fl.variants">
    <f:DynamicPage id="_IDGenDynamicPage" class="sapUiResponsiveContentPadding">
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <Title id="_IDGenTitle" text="JIRA" level="H2"/>
                </f:heading>
                <f:snappedContent>
                    <Panel id="_IDGenPanel" headerText="Process Area">
                        <HeaderContainer id="_IDGenHeaderContainer" scrollStep="200" showDividers="false" content="{
                                    path: '/ProcessAreaEntity'
                                }">
                            <GenericTile id="_IDGenGenericTile" header="{functionalArea}" press="onTilePress">
                                <TileContent id="_IDGenTileContent" footer="Functional Lead: {prcoessAreaManager}">
                                    <NumericContent id="_IDGenNumericContent" value="{totalDefects}" valueColor="Good"/>
                                </TileContent>
                            </GenericTile>
                        </HeaderContainer>
                    </Panel>
                    <Panel id="_IDGenPanel1" headerText="Filter Count">
                        <Text id="_IDGenText" text="{fbConditions>/filtersTextInfo}"/>
                    </Panel>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1" pinnable="true">
                <macros:FilterBar id="FilterBar" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.SelectionFields#filterBarMacro" showClearButton="true" showMessages="true" liveMode="true"/>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <macros:Table id="Table" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.LineItem#tableMacro" filterBar="FilterBar" header="All Issues" type="GridTable" widthIncludingColumnHeader="true"/>
        </f:content>
    </f:DynamicPage>
</mvc:View>