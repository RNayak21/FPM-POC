<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Label
        id="IDHeaderMatLabel"
        required="true"
        text="{i18n>headerMaterial}"
    />
    <Select
        id="IDHeaderMat"
        class="sapUiTinyMarginBottom"
        width="100%"
        forceSelection="false"
        change="handler.onStatusCodeChange"
        core:require="{handler: 'demo/com/demofpm/ext/customFilter/AuthorityFilter'}"
        selectedKey="{path: 'filterValues>', type: 'sap.fe.macros.filter.type.Value', 
            formatOptions: { operator: 'demo.com.demofpm.ext.customFilter.AuthorityFilter.onChangeAuthority' }}"
    >
        <items>
            <core:Item
                id="ManagerSelection"
                key="0"
                text="Manager"
            />
            <core:Item
                id="OtherSelection"
                key="1"
                text="All Users"
            />
        </items>
    </Select>
</core:FragmentDefinition>
