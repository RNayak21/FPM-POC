<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:macrosTable="sap.fe.macros.table"  xmlns="sap.m" xmlns:macros="sap.fe.macros" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="demo.com.demofpm.ext.main.Main" xmlns:f="sap.f" xmlns:v="sap.ui.fl.variants">
<NavContainer id="navContainer" height="100%">
    <f:DynamicPage id="_IDGenDynamicPage" class="sapUiResponsiveContentPadding">
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                <f:heading>
                    <Title id="_IDGenTitle" text="JIRA DASHBOARD" level="H2"/>
                </f:heading>
                <f:snappedContent>
                    <Panel id="_IDGenPanel" headerText="Process Area - HIGH PRIORITY DEFECT">
                        <HeaderContainer id="_IDGenHeaderContainer" scrollStep="200" showDividers="false" content="{
                                    path: '/ProcessAreaEntity'
                                }">
                            <GenericTile id="_IDGenGenericTile" header="{functionalArea}" press="onTilePress">
                                <TileContent id="_IDGenTileContent" footer="Lead: {prcoessAreaManager}">
                                    <NumericContent id="_IDGenNumericContent" value="{totalDefects}" valueColor="Good"/>
                                </TileContent>
                            </GenericTile>
                        </HeaderContainer>
                    </Panel>
                    <Panel id="_IDGenPanel1" headerText="Filter Count">
                        <Text id="_IDGenText" text="{fbConditions>/filtersTextInfo}"/>
                    </Panel>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1" pinnable="true">
                <macros:FilterBar id="FilterBar" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.SelectionFields#filterBarMacro" showClearButton="true" showMessages="true" liveMode="true" filterChanged="onStatusCodeChange"/>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <macros:Table id="Table" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.LineItem#tableMacro" filterBar="FilterBar" header="All Issues" type="GridTable" widthIncludingColumnHeader="true" >
             <macrosTable:Column>
                    <macrosTable:Column id="harshika" header="{i18n>Batch}" key="Batch" importance="Low" widthIncludingColumnHeader="true"  >
                        <Text id="_IDGenText1" text=" Supplement"/>
                    </macrosTable:Column>
                </macrosTable:Column>
            </macros:Table>


                  
        </f:content>
    </f:DynamicPage>

<Page id="detailPage" title="Detail Page" showNavButton="true" navButtonPress="onNavBack">
            
            
    <content>
        <VBox class="sapUiSmallMargin">
             <Text text="Total Defects: {totalDefects}" />
             <Text text="Open Count: {openCount}" />
             <Text text="Closed Count: {closedCount}" />
             <Text text="Exceded Due Date: {excededDueDate}" />
             <Text text="In Progress Count: {inProgressCount}" />
             <Text text="Functional Area: {functionalArea}" />
             <Text text="Prcoess Area Manager : {prcoessAreaManager}" />
        
 
      
        </VBox>
    </content>
</Page>
    </NavContainer>
</mvc:View>