<mvc:View xmlns:simple="sap.gantt.simple" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:macrosTable="sap.fe.macros.table" xmlns="sap.m" xmlns:macros="sap.fe.macros" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="demo.com.demofpm.ext.main.Main" xmlns:f="sap.f" xmlns:v="sap.ui.fl.variants" xmlns:filterBar="sap.fe.macros.filterBar">
    <NavContainer id="navContainer" height="100%">
        <f:DynamicPage id="_IDGenDynamicPage" class="sapUiResponsiveContentPadding" showFooter="true">
            <f:title>
                <f:DynamicPageTitle id="_IDGenDynamicPageTitle">
                    <f:heading>
                        <Title id="_IDGenTitle" text="JIRA DASHBOARD" level="H2"/>
                    </f:heading>
                    <f:snappedContent>
                        <Panel id="_IDGenPanel" headerText="Process Area - HIGH PRIORITY DEFECT">
                            <HeaderContainer id="_IDGenHeaderContainer" scrollStep="200" showDividers="false" content="{
                                    path: '/ProcessAreaEntity'
                                }">
                                <GenericTile id="_IDGenGenericTile" header="{functionalArea}" press="onTilePress">
                                    <TileContent id="_IDGenTileContent" footer="Manager: {prcoessAreaManager}">
                                        <NumericContent id="_IDGenNumericContent" value="{totalDefects}" valueColor="Error"/>
                                    </TileContent>
                                </GenericTile>
                            </HeaderContainer>
                        </Panel>
                        <Panel id="_IDGenPanel1" headerText="Filter Count">
                            <Text id="_IDGenText" text="{fbConditions>/filtersTextInfo}"/>
                        </Panel>
                    </f:snappedContent>
                </f:DynamicPageTitle>
            </f:title>
            <f:header>
                <f:DynamicPageHeader id="_IDGenDynamicPageHeader1" pinnable="true">
                    <macros:FilterBar id="FilterBar" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.SelectionFields#filterBarMacro" showClearButton="true" showMessages="true" liveMode="false" filterChanged="onFilterChange">
                        <macros:filterFields>
                            <filterBar:FilterField id="_IDGenFilterField2" key="AuthorityKey" label="Authority" anchor="Type" placement="After">
                                <core:Fragment fragmentName="demo.com.demofpm.ext.customFilter.AuthorityFilter" type="XML"/>
                            </filterBar:FilterField>
                        </macros:filterFields>
                    </macros:FilterBar>
                </f:DynamicPageHeader>
            </f:header>
            <f:content>
                <VBox>
                    <FlexBox id="JiraDefectTable" visible="true">
                        <macros:Table id="Table" metaPath="/JiraEntity/@com.sap.vocabularies.UI.v1.LineItem#tableMacro" filterBar="FilterBar" header="{i18n>jiraIssues}" type="GridTable" widthIncludingColumnHeader="true" enableAutoColumnWidth="true" isSearchable="true">
                            <macros:columns>
                                <macrosTable:Column id="defectDesColumn" header="{i18n>description}" key="defectDesc" importance="Low" width="30rem" widthIncludingColumnHeader="true" placement="After" anchor="DataField::defectID">
                                    <Text id="_IDGenText1" text="{defectDesc}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="functionalAreaColumn" header="{i18n>FunctionalArea}" key="functionalArea" importance="Low" widthIncludingColumnHeader="true" placement="After" anchor="DataField::assignee">
                                    <Text id="_IDGenText2" text="{functionalArea}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="reporterColumn" header="{i18n>Reporter}" key="reporter" importance="Low" widthIncludingColumnHeader="true" placement="After" anchor="defectStatus">
                                    <Text id="_IDGenText7" text="{reporter}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="defectStatusColumn" header="{i18n>Status}" key="defectStatus" importance="Low" widthIncludingColumnHeader="true" placement="After" anchor="DataField::priority">
                                    <Text id="_IDGenText6" text="{defectStatus}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="StartDateColumn" header="{i18n>StartDate}" key="startDate" importance="Low" width="15rem" widthIncludingColumnHeader="true" placement="After" anchor="functionalArea">
                                    <Text id="_IDGenText3" text="{startDate}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="completedDateColumn" header="{i18n>CompletedDate}" key="completedDate" importance="Low" width="15rem" widthIncludingColumnHeader="true" placement="After" anchor="DataField::updatedDate">
                                    <Text id="_IDGenText4" text="{completedDate}"/>
                                </macrosTable:Column>
                                <macrosTable:Column id="teamColumn" header="{i18n>ResolvingTeam}" key="team" importance="Low" widthIncludingColumnHeader="true" placement="After" anchor="completedDate">
                                    <Text id="_IDGenText5" text="{team}"/>
                                </macrosTable:Column>
                            </macros:columns>
                        </macros:Table>
                    </FlexBox>
                    <FlexBox id="JiraBuildTable" visible="false">
                        <macros:Table id="Table2" type="GridTable" metaPath="/taskEntity/@com.sap.vocabularies.UI.v1.LineItem#tableMacro1" filterBar="FilterBar" header="JIRA Build" enableFullScreen="true" readOnly="true" selectionMode="None"/>
                    </FlexBox>
                </VBox>
            </f:content>
            <f:footer >
                <OverflowToolbar id="oToolBarContainer">
                    <ToolbarSpacer id="toolBarSpacerID" ></ToolbarSpacer>
                    <Toolbar id="oToolBar">
                        <Button icon="sap-icon://download" id="DownloadBn" text="Download Template" press="onDownloadTemplate"></Button>
                        <Button icon="sap-icon://upload" id="UploadBtn" text="Upload" press="openUploadDialog" type="Emphasized"></Button>
                    </Toolbar>
                </OverflowToolbar>
            </f:footer>
        </f:DynamicPage>
        
    </NavContainer>
</mvc:View>